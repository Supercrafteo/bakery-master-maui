<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PasteleriaMaui.Models"
             x:Class="PasteleriaMaui.Views.PedidoPersonalizadoPage"
             Title="Arma tu Pastel"
             BackgroundColor="#F7F4EF">

    <ScrollView>
        <VerticalStackLayout Padding="20,15,20,40" Spacing="20">
            
            <!-- Encabezado Principal -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="Creación de Pedido Artesanal" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#3E2723" 
                       HorizontalOptions="Center"/>
                <Label Text="Desliza para elegir sabor y cobertura con vista en vivo" 
                       FontSize="13" 
                       TextColor="#795548" 
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Barra de Selección Rápida de Sabores (Chips / Píldoras dinámicas) -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-20,0,-20,0">
                <HorizontalStackLayout Spacing="8" Padding="20,0">
                    <Button Text="🍫 Chocolate" 
                            BackgroundColor="#FAF8F5" 
                            TextColor="#5D4037" 
                            BorderColor="#E0D7CD"
                            BorderWidth="1"
                            CornerRadius="18" 
                            HeightRequest="36" 
                            FontSize="12" 
                            FontAttributes="Bold"
                            Padding="14,0"
                            Command="{Binding SeleccionarSaborRapidoCommand}"
                            CommandParameter="Chocolate" />

                    <Button Text="❤️ Red Velvet" 
                            BackgroundColor="#FAF8F5" 
                            TextColor="#C62828" 
                            BorderColor="#E0D7CD"
                            BorderWidth="1"
                            CornerRadius="18" 
                            HeightRequest="36" 
                            FontSize="12" 
                            FontAttributes="Bold"
                            Padding="14,0"
                            Command="{Binding SeleccionarSaborRapidoCommand}"
                            CommandParameter="Red Velvet" />

                    <Button Text="🍓 Vainilla" 
                            BackgroundColor="#FAF8F5" 
                            TextColor="#8D6E63" 
                            BorderColor="#E0D7CD"
                            BorderWidth="1"
                            CornerRadius="18" 
                            HeightRequest="36" 
                            FontSize="12" 
                            FontAttributes="Bold"
                            Padding="14,0"
                            Command="{Binding SeleccionarSaborRapidoCommand}"
                            CommandParameter="Vainilla" />

                    <Button Text="🥕 Zanahoria" 
                            BackgroundColor="#FAF8F5" 
                            TextColor="#E65100" 
                            BorderColor="#E0D7CD"
                            BorderWidth="1"
                            CornerRadius="18" 
                            HeightRequest="36" 
                            FontSize="12" 
                            FontAttributes="Bold"
                            Padding="14,0"
                            Command="{Binding SeleccionarSaborRapidoCommand}"
                            CommandParameter="Zanahoria" />

                    <Button Text="🍋 Limón" 
                            BackgroundColor="#FAF8F5" 
                            TextColor="#F57F17" 
                            BorderColor="#E0D7CD"
                            BorderWidth="1"
                            CornerRadius="18" 
                            HeightRequest="36" 
                            FontSize="12" 
                            FontAttributes="Bold"
                            Padding="14,0"
                            Command="{Binding SeleccionarSaborRapidoCommand}"
                            CommandParameter="Limón" />

                    <Button Text="☕ Mármol" 
                            BackgroundColor="#FAF8F5" 
                            TextColor="#6D4C41" 
                            BorderColor="#E0D7CD"
                            BorderWidth="1"
                            CornerRadius="18" 
                            HeightRequest="36" 
                            FontSize="12" 
                            FontAttributes="Bold"
                            Padding="14,0"
                            Command="{Binding SeleccionarSaborRapidoCommand}"
                            CommandParameter="Mármol" />

                    <Button Text="🍊 Naranja" 
                            BackgroundColor="#FAF8F5" 
                            TextColor="#EF6C00" 
                            BorderColor="#E0D7CD"
                            BorderWidth="1"
                            CornerRadius="18" 
                            HeightRequest="36" 
                            FontSize="12" 
                            FontAttributes="Bold"
                            Padding="14,0"
                            Command="{Binding SeleccionarSaborRapidoCommand}"
                            CommandParameter="Naranja" />

                    <Button Text="🥛 Tres Leches" 
                            BackgroundColor="#FAF8F5" 
                            TextColor="#5D4037" 
                            BorderColor="#E0D7CD"
                            BorderWidth="1"
                            CornerRadius="18" 
                            HeightRequest="36" 
                            FontSize="12" 
                            FontAttributes="Bold"
                            Padding="14,0"
                            Command="{Binding SeleccionarSaborRapidoCommand}"
                            CommandParameter="Esponja" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- CARRUSEL DE VISUALIZACIÓN DINÁMICO DE PASTELES -->
            <VerticalStackLayout Spacing="8">
                <CarouselView x:Name="CarruselSabores" 
                              ItemsSource="{Binding SaboresCarrusel}" 
                              CurrentItem="{Binding ItemCarruselActual, Mode=TwoWay}"
                              Position="{Binding PosicionCarrusel, Mode=TwoWay}"
                              PeekAreaInsets="25" 
                              HeightRequest="310" 
                              Loop="False"
                              HorizontalScrollBarVisibility="Never"
                              IndicatorView="IndicadorCarrusel">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="models:PastelVisualItem">
                            <Grid Padding="8,0">
                                <Border Stroke="#EAE4DB" 
                                        StrokeThickness="1" 
                                        BackgroundColor="#FFFFFF" 
                                        Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#8B5E34" Offset="0,6" Radius="12" Opacity="0.10" />
                                    </Border.Shadow>

                                    <Grid RowDefinitions="185, *">
                                        <!-- Imagen con Placeholder y Badges -->
                                        <Grid Grid.Row="0">
                                            <!-- Placeholder de respaldo -->
                                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                                <Label Text="{Binding Emoji}" FontSize="36" HorizontalOptions="Center" />
                                                <Label Text="Dolce Vita" FontSize="11" TextColor="#BCAAA4" HorizontalOptions="Center" />
                                            </VerticalStackLayout>

                                            <!-- Imagen fotográfica en alta resolución -->
                                            <Image Source="{Binding FotoUrl}" 
                                                   Aspect="AspectFill" 
                                                   HeightRequest="185" />

                                            <!-- Degradado suave inferior en la imagen -->
                                            <BoxView Color="#33000000" VerticalOptions="Fill" HorizontalOptions="Fill" />

                                            <!-- Badges de Sabor y Cobertura sobre la foto -->
                                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Start" VerticalOptions="Start" Margin="12,12,0,0">
                                                <Border BackgroundColor="#E6FFFFFF" StrokeThickness="0" Padding="8,4">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding BizcochoNombre, StringFormat='Sabor: {0}'}" FontSize="11" FontAttributes="Bold" TextColor="#3E2723" />
                                                </Border>

                                                <Border BackgroundColor="#E68B5E34" StrokeThickness="0" Padding="8,4">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding GlaseadoNombre, StringFormat='Cobertura: {0}'}" FontSize="11" FontAttributes="Bold" TextColor="#FFFFFF" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <!-- Botón Expandir Imagen en Lightbox -->
                                            <Border BackgroundColor="#B3000000" 
                                                    StrokeThickness="0" 
                                                    HeightRequest="28" 
                                                    WidthRequest="28" 
                                                    HorizontalOptions="End" 
                                                    VerticalOptions="Start" 
                                                    Margin="0,10,10,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Label Text="⇱" FontSize="15" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnExpandImageTapped" CommandParameter="{Binding FotoUrl}" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                        </Grid>

                                        <!-- Información de la combinación -->
                                        <VerticalStackLayout Grid.Row="1" Padding="14,10,14,12" Spacing="4">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" 
                                                       Text="{Binding Nombre}" 
                                                       FontSize="15" 
                                                       FontAttributes="Bold" 
                                                       TextColor="#3E2723" 
                                                       LineBreakMode="TailTruncation" />

                                                <Border Grid.Column="1" 
                                                        BackgroundColor="#F5F0E6" 
                                                        StrokeThickness="0" 
                                                        Padding="6,2">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Label Text="★ Seleccionable" FontSize="10" FontAttributes="Bold" TextColor="#8B5E34" />
                                                </Border>
                                            </Grid>

                                            <Label Text="{Binding Descripcion}" 
                                                   FontSize="12" 
                                                   TextColor="#795548" 
                                                   LineBreakMode="TailTruncation" 
                                                   MaxLines="2" />

                                            <Label Text="{Binding RellenoSugerido, StringFormat='💡 Relleno sugerido: {0}'}" 
                                                   FontSize="11" 
                                                   TextColor="#8D6E63" 
                                                   Margin="0,2,0,0" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <!-- Puntos indicadores de posición del carrusel -->
                <IndicatorView x:Name="IndicadorCarrusel" 
                               IndicatorColor="#D7CCC8" 
                               SelectedIndicatorColor="#8B5E34" 
                               HorizontalOptions="Center" 
                               Margin="0,2,0,4" />
            </VerticalStackLayout>

            <!-- Banner Informativo de Selección Actual en Tiempo Real -->
            <Border BackgroundColor="#FAF8F5" 
                    Stroke="#E0D7CD" 
                    StrokeThickness="1" 
                    Padding="14,10" 
                    Margin="0,-5,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *">
                    <Label Grid.Column="0" Text="✨" FontSize="18" VerticalOptions="Center" Margin="0,0,10,0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Vista previa activa reflejada en tu pedido:" FontSize="11" TextColor="#8D6E63" />
                        <Label Text="{Binding VistaPreviaSubtitulo}" FontSize="13" FontAttributes="Bold" TextColor="#3E2723" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Formulario de Configuración del Pastel y Pedido -->
            <Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="22" 
                    Margin="0,5,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="15" Opacity="0.06" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Label Text="Detalles de Personalización" FontSize="16" FontAttributes="Bold" TextColor="#3E2723" Margin="0,0,0,2"/>

                    <!-- Nombre del Pastel -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre de tu creación" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Entry Placeholder="Ponle un nombre a tu pastel" 
                                   Text="{Binding Nombre}" 
                                   BackgroundColor="Transparent" 
                                   TextColor="#3E2723" 
                                   PlaceholderColor="#BCAAA4" 
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Tamaño -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tamaño" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker Title="Selecciona el tamaño" 
                                    SelectedItem="{Binding Tamanio}" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#3E2723" 
                                    TitleColor="#BCAAA4" 
                                    VerticalOptions="Center">
                                <Picker.Items>
                                    <x:String>Chico</x:String>
                                    <x:String>Mediano</x:String>
                                    <x:String>Grande</x:String>
                                    <x:String>Extra Grande</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Sabor del Bizcocho (Sincronizado bidireccionalmente con el carrusel) -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sabor del Bizcocho" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker Title="Selecciona el bizcocho" 
                                    ItemsSource="{Binding Bizcochos}" 
                                    ItemDisplayBinding="{Binding Nombre}" 
                                    SelectedItem="{Binding BizcochoSeleccionado}" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#3E2723" 
                                    TitleColor="#BCAAA4" 
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Relleno -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Relleno" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker Title="Selecciona el relleno" 
                                    ItemsSource="{Binding Rellenos}" 
                                    ItemDisplayBinding="{Binding Nombre}" 
                                    SelectedItem="{Binding RellenoSeleccionado}" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#3E2723" 
                                    TitleColor="#BCAAA4" 
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Cobertura / Glaseado (Sincronizado bidireccionalmente con el carrusel) -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cobertura / Glaseado" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker Title="Selecciona la cobertura" 
                                    ItemsSource="{Binding Glaseados}" 
                                    ItemDisplayBinding="{Binding Nombre}" 
                                    SelectedItem="{Binding GlaseadoSeleccionado}" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#3E2723" 
                                    TitleColor="#BCAAA4" 
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Categoría -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Categoría" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker Title="Selecciona la categoría" 
                                    ItemsSource="{Binding Categorias}" 
                                    ItemDisplayBinding="{Binding categoria}" 
                                    SelectedItem="{Binding CategoriaSeleccionada}" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#3E2723" 
                                    TitleColor="#BCAAA4" 
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- URL de la Foto del Diseño (Dinámica según selección o editable) -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="URL de la Foto de Referencia" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Entry Placeholder="Se actualiza según tu selección de sabor/cobertura" 
                                   Text="{Binding FotoUrl}" 
                                   BackgroundColor="Transparent" 
                                   TextColor="#3E2723" 
                                   PlaceholderColor="#BCAAA4" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Grid Fecha y Cantidad -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <VerticalStackLayout Spacing="6" Grid.Column="0">
                            <Label Text="Fecha de Entrega" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                            <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <DatePicker MinimumDate="{Binding FechaMinima}" 
                                            Date="{Binding FechaEntrega}" 
                                            TextColor="#3E2723" 
                                            VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6" Grid.Column="1">
                            <Label Text="Cantidad" FontSize="13" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                            <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="50" Padding="15,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Entry Keyboard="Numeric" 
                                       Placeholder="1" 
                                       Text="{Binding Cantidad}" 
                                       BackgroundColor="Transparent" 
                                       TextColor="#3E2723" 
                                       PlaceholderColor="#BCAAA4" 
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Botón Confirmar y Realizar Pedido -->
            <Button Text="Confirmar y Realizar Pedido" 
                    BackgroundColor="#8B5E34" 
                    TextColor="#FFFFFF" 
                    FontAttributes="Bold" 
                    CornerRadius="14" 
                    HeightRequest="54" 
                    FontSize="16" 
                    Margin="0,5,0,10" 
                    Command="{Binding GuardarPedidoCommand}">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="10" Opacity="0.2" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
