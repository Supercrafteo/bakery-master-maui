<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasteleriaMaui.Views.RegistrarPedidoPage"
             Title="Programación de Pedido"
             BackgroundColor="#F7F4EF">

	<ScrollView>
		<VerticalStackLayout Padding="20,20,20,40" Spacing="20">
            <Label Text="Programar Entrega / Recolección" FontSize="22" FontAttributes="Bold" TextColor="#3E2723" HorizontalOptions="Center"/>

            <!-- Tarjeta de Resumen del Pastel a Comprar -->
            <Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="16"
                    Margin="0,0,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,4" Radius="10" Opacity="0.06" />
                </Border.Shadow>
                <Grid ColumnDefinitions="90, *" ColumnSpacing="15" VerticalOptions="Center">
                    <Border Grid.Column="0" 
                            StrokeThickness="0" 
                            BackgroundColor="#FAF8F5" 
                            HeightRequest="90" 
                            WidthRequest="90">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label Text="🎂" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Image Source="{Binding PastelAComprar.FotoUrl}" 
                                   Aspect="AspectFill" 
                                   HeightRequest="90" 
                                   WidthRequest="90" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                        <Label Text="{Binding PastelAComprar.Nombre}" FontSize="16" FontAttributes="Bold" TextColor="#3E2723" />
                        <Label Text="{Binding PastelAComprar.Tamanio, StringFormat='Tamaño: {0}'}" FontSize="12" TextColor="#795548" />
                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                            <Border BackgroundColor="#FAF8F5" Stroke="#E0D7CD" StrokeThickness="1" Padding="6,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label Text="{Binding PastelAComprar.Bizcocho.Nombre, StringFormat='Sabor: {0}'}" FontSize="11" TextColor="#5D4037" FontAttributes="Bold" />
                            </Border>
                            <Border BackgroundColor="#FFF8F5" Stroke="#FFCCBC" StrokeThickness="1" Padding="6,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label Text="{Binding PastelAComprar.Glaseado.Nombre, StringFormat='Glaseado: {0}'}" FontSize="11" TextColor="#D84315" FontAttributes="Bold" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

			<Border Stroke="#EAE4DB" 
                    StrokeThickness="1" 
                    BackgroundColor="#FFFFFF" 
                    Padding="25"
                    Margin="0,5,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Radius="15" Opacity="0.06" />
                </Border.Shadow>

				<VerticalStackLayout Spacing="18">
                    <!-- Modalidad de entrega/recolección -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Modalidad del Servicio" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="52" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker x:Name="PickerModalidad" Title="Selecciona la modalidad" TextColor="#3E2723" TitleColor="#BCAAA4" VerticalOptions="Center">
                                <Picker.Items>
                                    <x:String>Entrega a domicilio</x:String>
                                    <x:String>Recogida en sucursal</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Cantidad -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cantidad de Pasteles" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="52" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Entry x:Name="EntryCantidad" Text="1" Keyboard="Numeric" ClearButtonVisibility="WhileEditing" BackgroundColor="Transparent" TextColor="#3E2723" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Fecha de Entrega con validación de 48h -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Fecha de Entrega / Recolección" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="52" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <DatePicker x:Name="PickerFechaEntrega" Format="dd/MM/yyyy" TextColor="#3E2723" BackgroundColor="Transparent" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="* Requiere al menos 48 horas de anticipación artesanal." FontSize="11" TextColor="#8D6E63" Margin="4,2,0,0" />
                    </VerticalStackLayout>

                    <!-- Franja Horaria -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Franja Horaria" FontSize="14" FontAttributes="Bold" TextColor="#5D4037" Margin="4,0,0,0" />
                        <Border Stroke="#E0D7CD" StrokeThickness="1" BackgroundColor="#FAF8F5" HeightRequest="52" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker x:Name="PickerFranjaHoraria" Title="Selecciona un horario" TextColor="#3E2723" TitleColor="#BCAAA4" VerticalOptions="Center">
                                <Picker.Items>
                                    <x:String>Mañana (09:00 - 12:00)</x:String>
                                    <x:String>Mediodía (12:00 - 15:00)</x:String>
                                    <x:String>Tarde (15:00 - 18:00)</x:String>
                                    <x:String>Noche (18:00 - 20:00)</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Button Text="Confirmar Orden de Compra" 
                    Margin="0,10,0,0" 
                    HeightRequest="54"
                    CornerRadius="14"
                    BackgroundColor="#8B5E34"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    FontSize="16"
                    Clicked="OnGuardarClicked">
                <Button.Shadow>
                    <Shadow Brush="#8B5E34" Offset="0,6" Opacity="0.2" Radius="10" />
                </Button.Shadow>
            </Button>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
